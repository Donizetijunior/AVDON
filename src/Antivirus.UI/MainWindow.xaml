<Window x:Class="Antivirus.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:Antivirus.UI.Controls"
        mc:Ignorable="d"
        Title="AVDON" Height="620" Width="940"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Fg}"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <DockPanel>

        <!-- ── CUSTOM TITLE BAR ───────────────────────── -->
        <Border DockPanel.Dock="Top" Height="40"
                Background="{StaticResource Surface}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                            IsHitTestVisible="True">
                    <!-- Shield (Viewbox-based for crisp render) -->
                    <Viewbox Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Canvas Width="22" Height="24">
                            <Polygon Points="11,0 22,5 22,14 11,24 0,14 0,5"
                                     Fill="{StaticResource Accent}" Opacity="0.15"/>
                            <Polygon Points="11,1.5 20.5,6 20.5,14 11,22.5 1.5,14 1.5,6"
                                     Fill="Transparent"
                                     Stroke="{StaticResource Accent}" StrokeThickness="1.4"/>
                            <TextBlock Canvas.Left="6" Canvas.Top="3.5"
                                       Text="A" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource Accent}"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        </Canvas>
                    </Viewbox>
                    <!-- Wordmark -->
                    <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource Fg}">
                        <Run Text="AV"/>
                        <Run Text="DON" Foreground="{StaticResource Accent}"/>
                    </TextBlock>
                </StackPanel>

                <!-- Window controls — Windows 11 style -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch"
                            WindowChrome.IsHitTestVisibleInChrome="True">

                    <!-- About -->
                    <Button Click="About_Click" Width="60" Height="40" Padding="0" BorderThickness="0"
                            ToolTip="Sobre o AVDON" Background="Transparent" Cursor="Arrow">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" x:Name="Bd">
                                    <TextBlock Text="?" FontSize="14" FontWeight="Bold"
                                               Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Minimize -->
                    <Button Click="Minimize_Click" Width="46" Height="40" Padding="0" BorderThickness="0"
                            ToolTip="Minimizar" Background="Transparent" Cursor="Arrow">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="Transparent">
                                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{StaticResource FgMuted}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#18FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#28FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Maximize / Restore -->
                    <Button Click="MaxRestore_Click" Width="46" Height="40" Padding="0" BorderThickness="0"
                            ToolTip="Maximizar" Background="Transparent" Cursor="Arrow">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="Transparent">
                                    <TextBlock x:Name="icon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{StaticResource FgMuted}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#18FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#28FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Close -->
                    <Button Click="Close_Click" Width="46" Height="40" Padding="0" BorderThickness="0"
                            ToolTip="Fechar" Background="Transparent" Cursor="Arrow">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="Transparent">
                                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{StaticResource FgMuted}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#C42B1C"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#E81123"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ── STATUS BAR ─────────────────────────────── -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource FgDim}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Safe}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ScanStatus}" Foreground="{StaticResource FgMuted}" FontSize="12"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Foreground="{StaticResource FgDim}" FontSize="11" Margin="0,0,8,0">
                    <Run Text="{Binding SignatureCount, StringFormat=\{0:N0\}}"/>
                    <Run Text=" assinaturas"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <!-- ── MAIN TABCONTROL WITH SIDEBAR ──────────── -->
        <TabControl Style="{StaticResource SidebarTabControl}">

            <!-- ════════════════════════════════════════
                 ABA 0: DASHBOARD
                 Segoe MDL2: E80F = Home
            ════════════════════════════════════════ -->
            <TabItem Style="{StaticResource SidebarTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Início" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="28,24,28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ── Status Shield ── -->
                    <Border Grid.Row="0" Style="{StaticResource ContentCard}" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Accent bar lateral -->
                            <Border Grid.Column="0" CornerRadius="10,0,0,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Safe}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource Danger}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <!-- Conteúdo principal -->
                            <Grid Grid.Column="1" Margin="28,24,28,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Shield icon -->
                                <Grid Grid.Column="0" Width="80" Height="80" Margin="0,0,24,0">
                                    <Ellipse>
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource SafeDim}"/>
                                                <Setter Property="Stroke" Value="{StaticResource Safe}"/>
                                                <Setter Property="StrokeThickness" Value="2"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                                        <Setter Property="Fill" Value="{StaticResource DangerDim}"/>
                                                        <Setter Property="Stroke" Value="{StaticResource Danger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="34"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xEA18;"/>
                                                <Setter Property="Foreground" Value="{StaticResource Safe}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Texto de status -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="20" FontWeight="Bold" Margin="0,0,0,4">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Você está protegido"/>
                                                <Setter Property="Foreground" Value="{StaticResource Safe}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                                        <Setter Property="Text" Value="Proteção desativada"/>
                                                        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="{StaticResource FgMuted}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Monitoramento em tempo real ativo"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                                        <Setter Property="Text" Value="Ative o monitoramento para proteção contínua"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{StaticResource FgDim}" Margin="0,6,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value=""/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LastScanTime}" Value="{x:Null}">
                                                        <Setter Property="Text" Value="Nenhum scan realizado ainda"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{StaticResource FgDim}"
                                               Text="{Binding LastScanTime, StringFormat='Último scan: {0:dd/MM/yyyy HH:mm}', TargetNullValue=''}"/>
                                </StackPanel>

                                <!-- Botões de ação -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                            MinWidth="150">
                                    <Button Content="Scan Rápido"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding QuickScanCommand}"
                                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"
                                            Padding="18,10" FontSize="13"/>
                                    <Button Content="{Binding IsMonitoring, Converter={StaticResource MonitorButtonConverter}}"
                                            Margin="0,8,0,0" Padding="18,8" FontSize="12"
                                            Command="{Binding ToggleMonitorCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource DangerDim}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ── Metric cards ── -->
                    <UniformGrid Grid.Row="2" Rows="1" Columns="4">
                        <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="28" Height="28" CornerRadius="6"
                                            Background="{StaticResource DangerDim}" Margin="0,0,8,0">
                                        <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="{StaticResource Danger}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="AMEAÇAS BLOQUEADAS" Style="{StaticResource FieldLabel}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="30" FontWeight="Bold"
                                           Foreground="{StaticResource Danger}"
                                           Text="{Binding TotalThreatsBlocked}"/>
                                <TextBlock Text="Desde o início" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}" Margin="5,0,5,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="28" Height="28" CornerRadius="6"
                                            Background="{StaticResource AccentDim}" Margin="0,0,8,0">
                                        <TextBlock Text="&#xEBE8;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="{StaticResource Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="ASSINATURAS" Style="{StaticResource FieldLabel}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="30" FontWeight="Bold"
                                           Foreground="{StaticResource Accent}"
                                           Text="{Binding SignatureCount, StringFormat=\{0:N0\}}"/>
                                <TextBlock Text="Base MalwareBazaar" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}" Margin="5,0,5,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="28" Height="28" CornerRadius="6" Margin="0,0,8,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource SafeDim}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                                        <Setter Property="Background" Value="{StaticResource Surface3}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Safe}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="PROTEÇÃO" Style="{StaticResource FieldLabel}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="30" FontWeight="Bold"
                                           Text="{Binding MonitoredFolderCount}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Safe}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                            <Setter Property="Text" Value="Pastas monitoradas"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                                    <Setter Property="Text" Value="Proteção desativada"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}" Margin="10,0,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="28" Height="28" CornerRadius="6"
                                            Background="{StaticResource SafeDim}" Margin="0,0,8,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource SafeDim}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsApiKeySet}" Value="False">
                                                        <Setter Property="Background" Value="{StaticResource Surface3}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="&#xE9CE;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Safe}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsApiKeySet}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="CLAUDE AI" Style="{StaticResource FieldLabel}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="18" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Configurada"/>
                                            <Setter Property="Foreground" Value="{StaticResource Safe}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsApiKeySet}" Value="False">
                                                    <Setter Property="Text" Value="Não configurada"/>
                                                    <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Análise por IA" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- ── Live metrics row ── -->
                    <UniformGrid Grid.Row="3" Rows="1" Columns="3" Margin="0,8,0,0">
                        <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="28" Height="28" CornerRadius="6"
                                            Background="{StaticResource AccentDim}" Margin="0,0,8,0">
                                        <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="{StaticResource Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="UPTIME" Style="{StaticResource FieldLabel}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource Accent}"
                                           Text="{Binding UptimeDisplay}"/>
                                <TextBlock Text="Tempo de execução" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}" Margin="5,0,5,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="28" Height="28" CornerRadius="6"
                                            Background="{StaticResource DangerDim}" Margin="0,0,8,0">
                                        <TextBlock Text="&#xEBE8;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="{StaticResource Danger}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="AMEAÇAS HOJE" Style="{StaticResource FieldLabel}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock FontSize="30" FontWeight="Bold"
                                           Foreground="{StaticResource Danger}"
                                           Text="{Binding ThreatsTodayCount}"/>
                                <TextBlock Text="Detectadas em tempo real" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}" Margin="10,0,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="28" Height="28" CornerRadius="6"
                                            Background="{StaticResource WarnDim}" Margin="0,0,8,0">
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="{StaticResource Warn}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="EM QUARENTENA" Style="{StaticResource FieldLabel}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock FontSize="30" FontWeight="Bold"
                                           Foreground="{StaticResource Warn}"
                                           Text="{Binding QuarantineCountDisplay}"/>
                                <TextBlock Text="Arquivos isolados" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- ── Scan progress (shown during scan) ── -->
                    <Border Grid.Row="5" Style="{StaticResource ContentCard}"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource Fg}"
                                               Text="{Binding ScanStatus}"/>
                                    <TextBlock Foreground="{StaticResource Accent}" FontSize="13"
                                               Margin="8,0,0,0"
                                               Text="{Binding ScannedCount, StringFormat='({0:N0} arquivos)'}"/>
                                </StackPanel>
                                <ProgressBar IsIndeterminate="True" Height="4"/>
                                <TextBlock Foreground="{StaticResource FgMuted}" FontSize="11"
                                           Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                           Text="{Binding CurrentScanFile}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Cancelar" Margin="16,0,0,0"
                                    Command="{Binding CancelScanCommand}"
                                    Foreground="{StaticResource Danger}"
                                    Background="#26EF4444" BorderThickness="0"
                                    Padding="14,8" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════
                 ABA 1: ESCANEAR
                 Segoe MDL2: E721 = Search
            ════════════════════════════════════════ -->
            <TabItem Style="{StaticResource SidebarTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Escanear" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="28,24,28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Page header row -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SectionHeader}"
                                   Margin="0" Text="Escanear"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Scanning progress indicator -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Margin="0,0,12,0" VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Width="100" Height="4"
                                             Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                           Text="{Binding ScannedCount, StringFormat='{}{0:N0} arquivos…'}"/>
                                <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                           Margin="6,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="160"
                                           Text="{Binding CurrentScanFile}"/>
                                <Button Content="✕" Margin="10,0,0,0" Padding="6,2"
                                        FontSize="10" VerticalAlignment="Center"
                                        Command="{Binding CancelScanCommand}"
                                        Foreground="{StaticResource Danger}"
                                        Background="#26EF4444" BorderThickness="0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Stat cards -->
                    <UniformGrid Grid.Row="2" Rows="1" Columns="3" >
                        <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="ASSINATURAS" Style="{StaticResource FieldLabel}"/>
                                <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource Accent}"
                                           Text="{Binding SignatureCount, StringFormat=\{0:N0\}}"/>
                                <TextBlock Text="Base MalwareBazaar" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="LIMPOS" Style="{StaticResource FieldLabel}"/>
                                <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource Safe}"
                                           Text="{Binding CleanCount, FallbackValue=0}"/>
                                <TextBlock Text="Último scan" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="AMEAÇAS" Style="{StaticResource FieldLabel}"/>
                                <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource Danger}"
                                           Text="{Binding ThreatCount, FallbackValue=0}"/>
                                <TextBlock Text="Detectadas" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Scan mode card -->
                    <Border Grid.Row="4" Style="{StaticResource ContentCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubHeader}" Text="Iniciar Scan" Margin="0,0,0,16"/>
                            <UniformGrid Rows="1" Columns="3">

                                <!-- Quick Scan -->
                                <Border Margin="0,0,8,0" Background="{StaticResource Surface2}"
                                        CornerRadius="8" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                        Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="22" Foreground="{StaticResource Accent}" Margin="0,0,0,8"/>
                                        <TextBlock Text="Scan Rápido" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Fg}" FontSize="13" Margin="0,0,0,4"/>
                                        <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="11"
                                                   Text="Verifica pastas de alto risco: Temp, Downloads, Inicialização" Margin="0,0,0,12"/>
                                        <Button Content="Iniciar Scan Rápido"
                                                Style="{StaticResource PrimaryButton}"
                                                Command="{Binding QuickScanCommand}"
                                                IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Full Scan -->
                                <Border Margin="4,0,4,0" Background="{StaticResource Surface2}"
                                        CornerRadius="8" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                        Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="22" Foreground="{StaticResource Warn}" Margin="0,0,0,8"/>
                                        <TextBlock Text="Scan Completo" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Fg}" FontSize="13" Margin="0,0,0,4"/>
                                        <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="11"
                                                   Text="Varre todos os discos fixos. Pode levar vários minutos." Margin="0,0,0,12"/>
                                        <Button Content="Iniciar Scan Completo"
                                                Command="{Binding FullScanCommand}"
                                                IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Custom Scan -->
                                <Border Margin="8,0,0,0" Background="{StaticResource Surface2}"
                                        CornerRadius="8" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                        Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="22" Foreground="{StaticResource FgMuted}" Margin="0,0,0,8"/>
                                        <TextBlock Text="Scan Personalizado" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Fg}" FontSize="13" Margin="0,0,0,4"/>
                                        <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="11"
                                                   Text="Escolha um arquivo ou pasta específica para verificar." Margin="0,0,0,12"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Arquivo" Margin="0,0,6,0"
                                                    Command="{Binding ScanFileCommand}"
                                                    IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"/>
                                            <Button Content="Pasta"
                                                    Command="{Binding ScanFolderCommand}"
                                                    IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Results DataGrid -->
                    <Border Grid.Row="6" Style="{StaticResource ContentCard}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Padding="20,14,20,14"
                                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                                <TextBlock Style="{StaticResource SubHeader}" Margin="0" Text="Resultados"/>
                            </Border>
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding ScanResults}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nível" Width="90"
                                                       Binding="{Binding Level}"/>
                                    <DataGridTextColumn Header="Arquivo" Width="*"
                                                       Binding="{Binding FilePath}"/>
                                    <DataGridTextColumn Header="Hash SHA-256" Width="240"
                                                       Binding="{Binding Hash}"/>
                                    <DataGridTextColumn Header="Data" Width="140"
                                                       Binding="{Binding ScannedAt, StringFormat=\{0:dd/MM/yyyy HH:mm\}}"/>
                                    <DataGridTemplateColumn Header="Ação" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Quarentenar"
                                                        Command="{Binding DataContext.QuarantineResultCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="8,4" Margin="4,6"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════
                 ABA 2: PROTEÇÃO EM TEMPO REAL
                 Segoe MDL2: EA18 = ShieldSolid
            ════════════════════════════════════════ -->
            <TabItem Style="{StaticResource SidebarTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Proteção" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="28,24,28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}" Text="Proteção em Tempo Real"/>

                    <!-- Control card -->
                    <Border Grid.Row="2" Style="{StaticResource ContentCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Toggle row -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Margin="0,0,0,2">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubHeader}">
                                                <Setter Property="Text" Value="Monitoramento desativado"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                                        <Setter Property="Text" Value="Monitoramento ativo"/>
                                                        <Setter Property="Foreground" Value="{StaticResource Safe}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource MutedText}"
                                               Text="Detecta ameaças em novos arquivos automaticamente"/>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding ToggleMonitorCommand}"
                                        VerticalAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Content" Value="Iniciar"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                                    <Setter Property="Content" Value="Parar"/>
                                                    <Setter Property="Background" Value="#26EF4444"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <Separator Grid.Row="1" Margin="0,7"/>

                            <!-- Path row -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}"
                                           Text="PASTA MONITORADA" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="2" Text="{Binding MonitoredPath, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Pastas Protegidas -->
                    <Border Grid.Row="4" Style="{StaticResource ContentCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubHeader}" Margin="0,0,0,10" Text="Pastas Protegidas"/>
                            <!-- Not monitoring -->
                            <TextBlock Foreground="{StaticResource FgDim}" FontSize="12"
                                       Text="Nenhuma pasta monitorada.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- Monitored paths list -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                    <TextBlock Text="&#xED43;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" Foreground="{StaticResource Accent}"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Foreground="{StaticResource Fg}" FontSize="12"
                                               VerticalAlignment="Center">
                                        <Run Text="Downloads"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                    <TextBlock Text="&#xED43;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" Foreground="{StaticResource Accent}"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Área de Trabalho" Foreground="{StaticResource Fg}" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                    <TextBlock Text="&#xED43;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" Foreground="{StaticResource Accent}"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Inicialização do Windows" Foreground="{StaticResource Fg}" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Foreground="{StaticResource FgDim}" FontSize="11"
                                           Margin="0,6,0,0"
                                           Text="{Binding MonitoredFolderCount, StringFormat='{}{0} pasta(s) ativa(s)'}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Monitor log -->
                    <Border Grid.Row="6" Style="{StaticResource ContentCard}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Padding="20,14,20,14"
                                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                                <TextBlock Style="{StaticResource SubHeader}" Margin="0" Text="Log de atividade"/>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding MonitorLog}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         Background="#0A000000"
                                         Foreground="{StaticResource Fg}"
                                         FontFamily="Cascadia Code, Consolas, monospace"
                                         FontSize="12"
                                         BorderThickness="0"
                                         Padding="16"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════
                 ABA 3: QUARENTENA
                 Segoe MDL2: EF3C = Archive (Lock variant)
            ════════════════════════════════════════ -->
            <TabItem Style="{StaticResource SidebarTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xEF3C;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Quarentena" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="28,24,28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}" Text="Quarentena"/>

                    <Border Grid.Row="2" Style="{StaticResource ContentCard}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Padding="20,14,20,14"
                                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                                <TextBlock Style="{StaticResource SubHeader}" Margin="0" Text="Arquivos isolados"/>
                            </Border>
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding QuarantineEntries}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Arquivo Original" Width="*"
                                                       Binding="{Binding OriginalPath}"/>
                                    <DataGridTextColumn Header="Data" Width="140"
                                                       Binding="{Binding QuarantinedAt, StringFormat=\{0:dd/MM/yyyy HH:mm\}}"/>
                                    <DataGridTextColumn Header="Hash" Width="200"
                                                       Binding="{Binding Hash}"/>
                                    <DataGridTemplateColumn Header="Ações" Width="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Restaurar"
                                                            Command="{Binding DataContext.RestoreEntryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="8,4" Margin="4,6,2,6"/>
                                                    <Button Content="Inspecionar"
                                                            Command="{Binding DataContext.InspectEntryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="8,4" Margin="2,6,2,6"
                                                            Background="#1E3A5F" Foreground="#93C5FD"
                                                            BorderThickness="0" Cursor="Hand">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Button Content="Excluir"
                                                            Style="{StaticResource DangerButton}"
                                                            Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="8,4" Margin="2,6,4,6"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════
                 ABA 4: HISTÓRICO
                 Segoe MDL2: E81C = History
            ════════════════════════════════════════ -->
            <TabItem Style="{StaticResource SidebarTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Histórico" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="28,24,28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SectionHeader}"
                                   Margin="0" Text="Histórico de Scans"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding LoadHistoryCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Atualizar"
                                    Margin="0,0,8,0"/>
                            <Button Command="{Binding ExportHistoryCsvCommand}"
                                    Style="{StaticResource PrimaryButton}">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Exportar CSV" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Summary cards -->
                    <WrapPanel Grid.Row="2" Orientation="Horizontal">
                        <!-- Total scans -->
                        <Border x:Name="HistTotalCard" CornerRadius="10" Padding="20,14"
                                Background="{StaticResource Surface}" Margin="0,0,12,0" MinWidth="140">
                            <StackPanel>
                                <TextBlock x:Name="HistTotalNum"
                                           Text="{Binding HistoryTotalCount}"
                                           Foreground="{StaticResource Accent}"
                                           FontSize="28" FontWeight="Bold"/>
                                <TextBlock Text="Total de scans" Foreground="{StaticResource FgDim}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <!-- Threats found -->
                        <Border x:Name="HistThreatCard" CornerRadius="10" Padding="20,14"
                                Background="{StaticResource Surface}" Margin="0,0,12,0" MinWidth="140">
                            <StackPanel>
                                <TextBlock Text="{Binding HistoryThreatCount}"
                                           Foreground="{StaticResource Danger}"
                                           FontSize="28" FontWeight="Bold"/>
                                <TextBlock Text="Ameaças encontradas" Foreground="{StaticResource FgDim}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <!-- Last scan date -->
                        <Border x:Name="HistLastCard" CornerRadius="10" Padding="20,14"
                                Background="{StaticResource Surface}" MinWidth="140">
                            <StackPanel>
                                <TextBlock FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource Fg}"
                                           Text="{Binding LastScanTime, StringFormat='{}{0:dd/MM HH:mm}', TargetNullValue='—'}"/>
                                <TextBlock Text="Último scan" Foreground="{StaticResource FgDim}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <TextBlock Grid.Row="4" Style="{StaticResource MutedText}"
                               Text="Últimos 100 scans registrados no banco de dados"/>

                    <Border Grid.Row="6" Style="{StaticResource ContentCard}" Padding="0">
                        <DataGrid ItemsSource="{Binding HistoryResults}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nível" Width="90"
                                                   Binding="{Binding Level}"/>
                                <DataGridTextColumn Header="Arquivo" Width="*"
                                                   Binding="{Binding FilePath}"/>
                                <DataGridTextColumn Header="Hash SHA-256" Width="240"
                                                   Binding="{Binding Hash}"/>
                                <DataGridTextColumn Header="Data" Width="150"
                                                   Binding="{Binding ScannedAt, StringFormat=\{0:dd/MM/yyyy HH:mm\}}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════
                 ABA 5: REDE
                 Segoe MDL2: E968 = Network
            ════════════════════════════════════════ -->
            <TabItem Style="{StaticResource SidebarTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Rede" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="28,24,28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SectionHeader}"
                                   Margin="0" Text="Monitor de Rede"/>
                        <Button Grid.Column="1" Content="Atualizar"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding RefreshNetworkCommand}"
                                IsEnabled="{Binding IsRefreshingNetwork, Converter={StaticResource InverseBoolConverter}}"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Status -->
                    <TextBlock Grid.Row="2" Text="{Binding NetworkStatus}"
                               Foreground="{StaticResource FgMuted}" FontSize="12"/>

                    <!-- Connections table -->
                    <Border Grid.Row="4" Style="{StaticResource ContentCard}" Padding="0">
                        <DataGrid ItemsSource="{Binding NetworkConnections}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSuspicious}" Value="True">
                                            <Setter Property="Background" Value="#1A0505"/>
                                            <Setter Property="Foreground" Value="#F87171"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="⚠" Width="30"
                                                   Binding="{Binding IsSuspicious, Converter={StaticResource BoolToFlagConverter}}"/>
                                <DataGridTextColumn Header="IP Local" Width="140"
                                                   Binding="{Binding LocalAddress}"/>
                                <DataGridTextColumn Header="Porta" Width="70"
                                                   Binding="{Binding LocalPort}"/>
                                <DataGridTextColumn Header="IP Remoto" Width="*"
                                                   Binding="{Binding RemoteAddress}"/>
                                <DataGridTextColumn Header="Porta" Width="70"
                                                   Binding="{Binding RemotePort}"/>
                                <DataGridTextColumn Header="Estado" Width="110"
                                                   Binding="{Binding State}"/>
                                <DataGridTextColumn Header="Motivo" Width="220"
                                                   Binding="{Binding SuspicionReason}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════
                 ABA 6: CONFIGURAÇÕES
                 Segoe MDL2: E713 = Settings
            ════════════════════════════════════════ -->
            <TabItem Style="{StaticResource SidebarTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Segurança" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,24,28,24" MaxWidth="600" HorizontalAlignment="Left">

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Segurança Avançada"/>

                        <!-- Claude AI section -->
                        <Border Style="{StaticResource ContentCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SubHeader}" Text="Claude AI"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,16"
                                           Text="Análise inteligente de arquivos suspeitos sem hash conhecido."/>

                                <!-- API key status row -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsApiKeySet}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Safe}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Não configurada"/>
                                                    <Setter Property="Foreground" Value="{StaticResource FgMuted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsApiKeySet}" Value="True">
                                                            <Setter Property="Text" Value="Configurada"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Safe}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Alterar Chave"
                                            x:Name="ToggleApiKeyBtn"
                                            Click="ToggleApiKeyPanel_Click"
                                            Style="{StaticResource GhostButton}" FontSize="12"/>
                                </Grid>

                                <!-- Hidden input panel -->
                                <StackPanel x:Name="ApiKeyPanel" Visibility="Collapsed">
                                    <PasswordBox x:Name="ApiKeyBox" MaxLength="200"
                                                 PasswordChanged="ApiKeyBox_PasswordChanged"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Salvar" Style="{StaticResource PrimaryButton}"
                                                Click="SaveApiKey_Click" Margin="0,0,8,0"/>
                                        <Button Content="Cancelar" Click="CancelApiKey_Click"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                           Text="Opcional — o restante do antivírus funciona sem ela."/>
                            </StackPanel>
                        </Border>

                        <!-- Signatures section -->
                        <Border Style="{StaticResource ContentCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SubHeader}" Text="Banco de Assinaturas"/>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="ASSINATURAS CARREGADAS"/>
                                        <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                                                   FontSize="22" FontWeight="Bold"
                                                   Foreground="{StaticResource Accent}"
                                                   Text="{Binding SignatureCount, StringFormat=\{0:N0\}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button Content="Atualizar Agora"
                                                Style="{StaticResource PrimaryButton}"
                                                Command="{Binding UpdateSignaturesCommand}"
                                                IsEnabled="{Binding IsUpdatingSignatures, Converter={StaticResource InverseBoolConverter}}"/>
                                        <ProgressBar IsIndeterminate="True" Width="120" Height="4" Margin="0,8,0,0"
                                                     Visibility="{Binding IsUpdatingSignatures, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource MutedText}"
                                           Text="Fonte: MalwareBazaar — atualização automática a cada 24h"/>
                            </StackPanel>
                        </Border>

                        <!-- System section -->
                        <Border Style="{StaticResource ContentCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SubHeader}" Text="Sistema"/>

                                <CheckBox Content="Iniciar com o Windows" Margin="0,0,0,16"
                                          IsChecked="{Binding StartWithWindows}"/>

                                <Separator Margin="0,0,0,16"/>

                                <TextBlock Style="{StaticResource SubHeader}" Text="Scan Agendado" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}"
                                               Text="PASTA" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Text="{Binding ScheduledScanPath, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center"/>
                                </Grid>

                                <Button Command="{Binding ToggleScheduledScanCommand}"
                                        HorizontalAlignment="Left">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Setter Property="Content" Value="Iniciar Scan Agendado"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsScheduledScanRunning}" Value="True">
                                                    <Setter Property="Content" Value="Parar Scan Agendado"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Save -->
                        <Button Content="Salvar Configurações"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveApiKeyCommand}"
                                HorizontalAlignment="Left"/>

                        <!-- ── DARK WEB MONITOR ── -->
                        <TextBlock Style="{StaticResource SectionHeader}"
                                   Text="Monitoramento Dark Web" Margin="0,32,0,8"/>

                        <Border Style="{StaticResource ContentCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Verifique se seu e-mail apareceu em vazamentos de dados (HaveIBeenPwned)."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding DarkWebEmail, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,8,0"/>
                                    <Button Grid.Column="1"
                                            Content="Verificar"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding CheckDarkWebCommand}"
                                            IsEnabled="{Binding IsDarkWebChecking, Converter={StaticResource InverseBoolConverter}}"/>
                                </Grid>

                                <!-- Status -->
                                <TextBlock Text="{Binding DarkWebStatus}"
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap"/>

                                <!-- Breaches list -->
                                <ItemsControl ItemsSource="{Binding DarkWebBreaches}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1A0D0D" BorderBrush="#40EF4444"
                                                    BorderThickness="1" CornerRadius="8"
                                                    Padding="14,10" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontWeight="SemiBold" Foreground="#F87171" FontSize="13"/>
                                                        <TextBlock Text="{Binding BreachDate, StringFormat='Vazamento: {0}'}"
                                                                   Foreground="#94A3B8" FontSize="11"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding PwnCount, StringFormat='{}{0:N0} contas'}"
                                                               Foreground="#EF4444" FontSize="11"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- ── DNS BLOCKING ── -->
                        <TextBlock Style="{StaticResource SectionHeader}"
                                   Text="Bloqueio de DNS" Margin="0,32,0,8"/>

                        <Border Style="{StaticResource ContentCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Bloqueia domínios maliciosos conhecidos via arquivo hosts do Windows. Requer privilégios de administrador."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <!-- Admin warning -->
                                <Border CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                                        Background="#1A1200">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAdmin}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="⚠ Execute o AVDON como Administrador para usar esta funcionalidade."
                                               Foreground="#FBBF24" FontSize="12" TextWrapping="Wrap"/>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Ativar Bloqueio DNS"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding EnableDnsBlockingCommand}"
                                            IsEnabled="{Binding IsDnsBlocking, Converter={StaticResource InverseBoolConverter}}"
                                            Margin="0,0,8,0"/>
                                    <Button Content="Desativar"
                                            Command="{Binding DisableDnsBlockingCommand}"
                                            IsEnabled="{Binding IsDnsBlocking, Converter={StaticResource InverseBoolConverter}}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="12,8"/>
                                </StackPanel>

                                <TextBlock Text="{Binding DnsBlockStatus}"
                                           Style="{StaticResource MutedText}" Margin="0,10,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Scheduled Scan Section -->
                        <Border Style="{StaticResource ContentCard}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Scan Agendado" Style="{StaticResource SubHeader}"/>

                                <TextBlock Text="Registra uma tarefa no Agendador do Windows para executar scans automáticos mesmo com a janela fechada."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <!-- Interval picker -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Intervalo (horas):" Foreground="{StaticResource Fg}"
                                               FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Width="60" Text="{Binding ScheduleIntervalHours, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="6,4"/>
                                </StackPanel>

                                <!-- Buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="Ativar Agendamento"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding EnableTaskScheduleCommand}"
                                            IsEnabled="{Binding IsScheduleEnabled, Converter={StaticResource InverseBoolConverter}}"
                                            Margin="0,0,8,0"/>
                                    <Button Content="Desativar"
                                            Command="{Binding DisableTaskScheduleCommand}"
                                            IsEnabled="{Binding IsScheduleEnabled}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="12,8"/>
                                </StackPanel>

                                <!-- Next run -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Próximo scan: " Foreground="#64748B" FontSize="12"/>
                                    <TextBlock Text="{Binding ScheduleNextRun}" Foreground="#94A3B8" FontSize="12"/>
                                </StackPanel>

                                <TextBlock Text="{Binding ScheduleStatus}"
                                           Foreground="#94A3B8" FontSize="12" Margin="0,6,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Aba 6: Relatórios -->
            <TabItem Style="{StaticResource SidebarTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Relatórios" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>

                        <!-- Summary cards -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="TOTAL SCANEADOS"/>
                                    <TextBlock FontSize="28" FontWeight="Bold" Foreground="{StaticResource Fg}" Margin="0,4,0,0"
                                               Text="{Binding ReportSummary.Total, FallbackValue='—'}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="LIMPOS"/>
                                    <TextBlock FontSize="28" FontWeight="Bold" Foreground="{StaticResource Safe}" Margin="0,4,0,0"
                                               Text="{Binding ReportSummary.Clean, FallbackValue='—'}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="SUSPEITOS"/>
                                    <TextBlock FontSize="28" FontWeight="Bold" Foreground="{StaticResource Warn}" Margin="0,4,0,0"
                                               Text="{Binding ReportSummary.Suspicious, FallbackValue='—'}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="MALICIOSOS"/>
                                    <TextBlock FontSize="28" FontWeight="Bold" Foreground="{StaticResource Danger}" Margin="0,4,0,0"
                                               Text="{Binding ReportSummary.Malicious, FallbackValue='—'}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Chart section -->
                        <Border Style="{StaticResource ContentCard}" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="AMEAÇAS — ÚLTIMOS 30 DIAS"
                                               Style="{StaticResource FieldLabel}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="↻ Atualizar"
                                                Command="{Binding RefreshReportCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="10,6" Margin="0,0,8,0"/>
                                        <Button Content="⬇ Exportar HTML"
                                                Command="{Binding ExportHtmlReportCommand}"
                                                Style="{StaticResource PrimaryButton}"
                                                Padding="10,6"/>
                                    </StackPanel>
                                </Grid>

                                <ctrl:ThreatBarChart Stats="{Binding DailyStats}" Height="180"/>

                                <!-- Legend -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <Ellipse Width="8" Height="8" Fill="#22C55E" VerticalAlignment="Center"/>
                                    <TextBlock Text="Limpo" Foreground="#94A3B8" FontSize="11" Margin="4,0,16,0"/>
                                    <Ellipse Width="8" Height="8" Fill="#F59E0B" VerticalAlignment="Center"/>
                                    <TextBlock Text="Suspeito" Foreground="#94A3B8" FontSize="11" Margin="4,0,16,0"/>
                                    <Ellipse Width="8" Height="8" Fill="#EF4444" VerticalAlignment="Center"/>
                                    <TextBlock Text="Malicioso" Foreground="#94A3B8" FontSize="11" Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Most common threat -->
                        <Border Style="{StaticResource ContentCard}" Padding="16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="AMEAÇA MAIS FREQUENTE" Margin="0,0,0,8"/>
                                <TextBlock FontSize="15" Foreground="{StaticResource Fg}" TextWrapping="Wrap"
                                           Text="{Binding ReportSummary.MostCommonThreat, FallbackValue='Nenhum dado ainda'}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Aba 7: Configurações -->
            <TabItem Style="{StaticResource SidebarTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Configurações" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel MaxWidth="680">

                        <!-- Protection -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Proteção" Style="{StaticResource SubHeader}"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Quarentena automática" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Mover automaticamente arquivos maliciosos para quarentena ao detectar."
                                                   FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AutoQuarantine}" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Notificar ao detectar ameaça" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Exibir alerta em popup quando uma ameaça for encontrada."
                                                   FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding NotifyOnThreat}" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Notificar ao concluir scan agendado" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Exibir balão na bandeja ao terminar um scan agendado."
                                                   FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding NotifyOnScheduledScan}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Scan options -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Scan" Style="{StaticResource SubHeader}"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Escanear arquivos compactados" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Inspecionar o conteúdo de .zip, .7z, .rar etc. (mais lento)."
                                                   FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding ScanArchives}" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Escanear USB ao inserir" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Iniciar scan automaticamente ao conectar um drive removível."
                                                   FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding ScanUsbOnInsert}" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Tamanho máximo de arquivo (MB)" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Ignorar arquivos maiores que este limite durante o scan."
                                                   FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding MaxFileSizeMB, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#0F172A" Foreground="{StaticResource Fg}"
                                             BorderBrush="#334155" Padding="8,6"
                                             VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Exclusion paths -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Caminhos Excluídos" Style="{StaticResource SubHeader}"/>
                                <TextBlock Text="Pastas e arquivos que serão ignorados durante qualquer scan."
                                           Style="{StaticResource MutedText}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                <!-- Add exclusion row -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding NewExclusionPath, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#0F172A" Foreground="{StaticResource Fg}"
                                             BorderBrush="#334155" Padding="8,6"
                                             />
                                    <Button Grid.Column="1" Content="📁"
                                            Command="{Binding BrowseExclusionPathCommand}"
                                            Padding="10,6" Margin="6,0,0,0"
                                            Background="#334155" Foreground="{StaticResource Fg}"
                                            BorderThickness="0"/>
                                    <Button Grid.Column="2" Content="Adicionar"
                                            Command="{Binding AddExclusionPathCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="10,6" Margin="6,0,0,0"/>
                                </Grid>

                                <!-- Exclusion list -->
                                <ItemsControl ItemsSource="{Binding ExclusionPaths}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="#0F172A" CornerRadius="4" Padding="8,5">
                                                    <TextBlock Text="{Binding}" Foreground="#94A3B8" FontSize="12"
                                                               FontFamily="Cascadia Code, Consolas, monospace"/>
                                                </Border>
                                                <Button Grid.Column="1" Content="✕"
                                                        Command="{Binding DataContext.RemoveExclusionPathCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="8,5" Margin="6,0,0,0"
                                                        Background="#EF4444" Foreground="White"
                                                        BorderThickness="0" FontSize="11"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Shell context menu integration -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Integração com Explorer" Style="{StaticResource SubHeader}"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,12" TextWrapping="Wrap"
                                           Text="Adiciona a opção 'Escanear com AVDON' no menu de contexto (clique direito) de arquivos e pastas no Explorer. Requer permissão de Administrador."/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="✓ Registrado"/>
                                                <Setter Property="Foreground" Value="#22C55E"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsShellMenuRegistered}" Value="False">
                                                        <Setter Property="Text" Value="Não registrado"/>
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Grid.Column="1"
                                            Content="Registrar"
                                            Command="{Binding RegisterShellMenuCommand}"
                                            IsEnabled="{Binding IsShellMenuRegistered, Converter={StaticResource InverseBoolConverter}}"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="12,6" Margin="8,0,0,0"/>
                                    <Button Grid.Column="2"
                                            Content="Remover"
                                            Command="{Binding UnregisterShellMenuCommand}"
                                            IsEnabled="{Binding IsShellMenuRegistered}"
                                            Background="#334155" Foreground="#94A3B8"
                                            BorderThickness="0" Padding="12,6" Margin="8,0,0,0"/>
                                </Grid>

                                <TextBlock Text="{Binding ShellMenuStatus}" FontSize="11"
                                           Foreground="#94A3B8" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Save row -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SettingsStatus}" Foreground="#22C55E"
                                       FontSize="12" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="💾 Salvar Configurações"
                                    Command="{Binding SaveSettingsCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="14,8"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Aba 8: Processos -->
            <TabItem Style="{StaticResource SidebarTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Processos" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header row -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SectionHeader}" Margin="0" Text="MONITOR DE PROCESSOS"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{Binding IsScanningProcesses, Converter={StaticResource MonitorButtonConverter},
                                                       ConverterParameter='Parar Scan|🔍 Escanear Processos'}"
                                    Command="{Binding ScanProcessesCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="160"/>
                        </StackPanel>
                    </Grid>

                    <!-- Status bar -->
                    <Border Grid.Row="1" Style="{StaticResource SummaryBar}" Padding="10,6" Margin="0,0,0,10">
                        <TextBlock Text="{Binding ProcessStatus}" Style="{StaticResource MutedText}"/>
                    </Border>

                    <!-- Process DataGrid -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding ProcessEntries}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              BorderThickness="0"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="Malicious">
                                        <Setter Property="Foreground" Value="#FCA5A5"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Suspicious">
                                        <Setter Property="Foreground" Value="#FCD34D"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PID"     Binding="{Binding Pid}"          Width="60"/>
                            <DataGridTextColumn Header="PROCESSO" Binding="{Binding Name}"         Width="160"/>
                            <DataGridTextColumn Header="NÍVEL"   Binding="{Binding Level}"         Width="90"/>
                            <DataGridTextColumn Header="RAM (MB)" Binding="{Binding WorkingSetMB}" Width="80"/>
                            <DataGridTextColumn Header="NOTA"    Binding="{Binding LevelNote}"     Width="140"/>
                            <DataGridTextColumn Header="CAMINHO" Binding="{Binding FilePath}"      Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Aba 9: Wi-Fi -->
            <TabItem Style="{StaticResource SidebarTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Wi-Fi" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Scanner de Segurança Wi-Fi" Style="{StaticResource SubHeader}" Margin="0"/>
                            <TextBlock Text="Detecta redes abertas, WEP e outras configurações inseguras"
                                       Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Escanear Redes"
                                Command="{Binding ScanWifiCommand}"
                                IsEnabled="{Binding IsScanningWifi, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource OutlineButton}"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Summary bar -->
                    <Border Grid.Row="1" Style="{StaticResource SummaryBar}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CONECTADO" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding ConnectedSsid}" FontSize="13"
                                           Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="SEGURANÇA" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding ConnectedSecurity}" FontSize="13"
                                           FontWeight="SemiBold" Foreground="{StaticResource Safe}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="REDES INSEGURAS" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding WifiInsecureCount}" FontSize="20"
                                           FontWeight="Bold" Foreground="{StaticResource Safe}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="STATUS" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding WifiStatus}" Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Networks DataGrid -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding WifiNetworks}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              BorderThickness="0"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInsecure}" Value="True">
                                        <Setter Property="Foreground" Value="#FCA5A5"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SSID"       Binding="{Binding SSID}"           Width="*"/>
                            <DataGridTextColumn Header="SEGURANÇA"  Binding="{Binding Security}"       Width="110"/>
                            <DataGridTextColumn Header="SINAL"      Binding="{Binding SignalPercent, StringFormat='{}{0}%'}" Width="70"/>
                            <DataGridTextColumn Header="CANAL"      Binding="{Binding Channel}"        Width="70"/>
                            <DataGridTextColumn Header="BSSID"      Binding="{Binding BSSID}"          Width="150"/>
                            <DataGridTextColumn Header="CONECTADO"  Binding="{Binding IsConnected}"    Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Spinner -->
                    <TextBlock Grid.Row="3" Margin="0,8,0,0"
                               Text="Escaneando redes Wi-Fi…"
                               Foreground="{StaticResource Accent}" FontSize="11"
                               Visibility="{Binding IsScanningWifi, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </TabItem>

            <!-- Aba 10: Integridade -->
            <TabItem Style="{StaticResource SidebarTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xEBE8;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Integridade" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Monitor de Integridade de Arquivos" Style="{StaticResource SubHeader}" Margin="0"/>
                            <TextBlock Text="Detecta modificações em arquivos críticos do sistema Windows"
                                       Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Criar Snapshot"
                                    Command="{Binding TakeIntegritySnapshotCommand}"
                                    IsEnabled="{Binding IsCheckingIntegrity, Converter={StaticResource InverseBoolConverter}}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,8" Margin="0,0,8,0"/>
                            <Button Content="Verificar Integridade"
                                    Command="{Binding VerifyIntegrityCommand}"
                                    IsEnabled="{Binding IsCheckingIntegrity, Converter={StaticResource InverseBoolConverter}}"
                                    Style="{StaticResource OutlineButton}"
                                    Padding="12,8"/>
                        </StackPanel>
                    </Grid>

                    <!-- Summary bar -->
                    <Border Grid.Row="1" Style="{StaticResource SummaryBar}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TOTAL" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding IntegrityResults.Count}" FontSize="20"
                                           Foreground="{StaticResource Fg}" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="MODIFICADOS" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding IntegrityModifiedCount}" FontSize="20"
                                           FontWeight="Bold" Foreground="{StaticResource Safe}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="AUSENTES" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding IntegrityMissingCount}" FontSize="20"
                                           FontWeight="Bold" Foreground="{StaticResource Danger}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="STATUS" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding IntegrityStatus}" Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Results DataGrid -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding IntegrityResults}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              BorderThickness="0"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Modified">
                                        <Setter Property="Foreground" Value="#FCA5A5"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Missing">
                                        <Setter Property="Foreground" Value="#F87171"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="New">
                                        <Setter Property="Foreground" Value="#FCD34D"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="OK">
                                        <Setter Property="Foreground" Value="#34D399"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STATUS"       Binding="{Binding Status}"        Width="90"/>
                            <DataGridTextColumn Header="ARQUIVO"      Binding="{Binding FilePath}"      Width="*"/>
                            <DataGridTextColumn Header="HASH ESPERADO" Binding="{Binding ExpectedHash}" Width="130"/>
                            <DataGridTextColumn Header="HASH ATUAL"   Binding="{Binding ActualHash}"    Width="130"/>
                            <DataGridTextColumn Header="SNAPSHOT"
                                                Binding="{Binding SnapshotTime, StringFormat='dd/MM HH:mm'}"
                                                Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Spinner -->
                    <TextBlock Grid.Row="3" Margin="0,8,0,0"
                               Text="Verificando integridade…"
                               Foreground="{StaticResource Accent}" FontSize="11"
                               Visibility="{Binding IsCheckingIntegrity, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </TabItem>

            <!-- Aba 10: Inicialização -->
            <TabItem Style="{StaticResource SidebarTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE9E9;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Inicialização" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Programas de Inicialização" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource Fg}"/>
                            <TextBlock Text="Itens que iniciam automaticamente com o Windows"
                                       FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="🔍 Escanear Inicialização"
                                Command="{Binding ScanStartupCommand}"
                                IsEnabled="{Binding IsLoadingStartup, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource OutlineButton}"
                                Padding="14,8" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Summary bar -->
                    <Border Grid.Row="1" Style="{StaticResource SummaryBar}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TOTAL" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding StartupItems.Count}" FontSize="20"
                                           Foreground="{StaticResource Fg}" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="SUSPEITOS" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding StartupSuspiciousCount}" FontSize="20"
                                           FontWeight="Bold" Foreground="{StaticResource Warn}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="STATUS" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding StartupStatus}" Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Startup items DataGrid -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding StartupItems}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              BorderThickness="0"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              x:Name="StartupGrid">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="Suspicious">
                                        <Setter Property="Foreground" Value="#FCD34D"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Malicious">
                                        <Setter Property="Foreground" Value="#FCA5A5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NOME"       Binding="{Binding Name}"      Width="160"/>
                            <DataGridTextColumn Header="NÍVEL"      Binding="{Binding Level}"     Width="90"/>
                            <DataGridTextColumn Header="FONTE"      Binding="{Binding Source}"    Width="120"/>
                            <DataGridTextColumn Header="PUBLISHER"  Binding="{Binding Publisher}" Width="140"/>
                            <DataGridTextColumn Header="CAMINHO"    Binding="{Binding FilePath}"  Width="*"/>
                            <DataGridTemplateColumn Header="AÇÕES" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="🔍 Investigar"
                                                    Command="{Binding DataContext.InvestigateStartupItemCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    Foreground="#38BDF8"
                                                    BorderThickness="1" BorderBrush="#38BDF8"
                                                    Padding="6,2" FontSize="11" Cursor="Hand" Margin="4,2"/>
                                            <Button Content="⛔ Desabilitar"
                                                    Command="{Binding DataContext.DisableStartupItemCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    Foreground="#F87171"
                                                    BorderThickness="1" BorderBrush="#F87171"
                                                    Padding="6,2" FontSize="11" Cursor="Hand" Margin="4,2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Loading indicator -->
                    <TextBlock Grid.Row="3" Margin="0,8,0,0"
                               Text="Escaneando itens de inicialização…"
                               Foreground="{StaticResource Accent}" FontSize="11"
                               Visibility="{Binding IsLoadingStartup, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </TabItem>

            <!-- Aba 10: Eventos -->
            <TabItem Style="{StaticResource SidebarTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Eventos" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header row -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Histórico de Eventos" Style="{StaticResource SubHeader}"
                                   Margin="0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding EventsTodayCount, StringFormat='Hoje: {0}'}"
                                       Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Button Content="Atualizar" Command="{Binding RefreshEventsCommand}"
                                    Style="{StaticResource OutlineButton}" Padding="12,6"/>
                        </StackPanel>
                    </Grid>

                    <!-- Sig DB info row -->
                    <Border Grid.Row="1" Style="{StaticResource SummaryBar}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="BASE DE ASSINATURAS" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding SignatureCount, StringFormat='{}{0:N0} assinaturas'}"
                                           FontSize="13" Foreground="{StaticResource Fg}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="ÚLTIMA ATUALIZAÇÃO" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding SigLastUpdated}" FontSize="13"
                                           Foreground="{StaticResource Fg}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="EVENTOS HOJE" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding EventsTodayCount}" FontSize="13"
                                           Foreground="{StaticResource Accent}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="3" Content="Atualizar Assinaturas"
                                    Command="{Binding UpdateSignaturesCommand}"
                                    IsEnabled="{Binding IsUpdatingSignatures, Converter={StaticResource InverseBoolConverter}}"
                                    Style="{StaticResource OutlineButton}"
                                    Padding="12,6" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Event list -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding EventLog}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              BorderThickness="0"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="ThreatDetected">
                                        <Setter Property="Foreground" Value="#FCA5A5"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="FileQuarantined">
                                        <Setter Property="Foreground" Value="#FCD34D"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="SignaturesUpdated">
                                        <Setter Property="Foreground" Value="#34D399"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DATA/HORA" Binding="{Binding Timestamp, StringFormat='dd/MM HH:mm:ss'}" Width="130"/>
                            <DataGridTextColumn Header="TIPO"      Binding="{Binding Kind}"      Width="130"/>
                            <DataGridTextColumn Header="RESUMO"    Binding="{Binding Summary}"   Width="*"/>
                            <DataGridTextColumn Header="DETALHE"   Binding="{Binding Detail}"    Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Aba 11: Varredura de Segurança -->
            <TabItem Style="{StaticResource SidebarTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8B6;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Varredura" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ── HOSTS FILE SECTION ── -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Verificador do Arquivo Hosts" Style="{StaticResource SubHeader}" Margin="0"/>
                            <TextBlock Text="{Binding HostsStatus}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource StatCard}" Padding="10,4" Margin="0,0,10,0" CornerRadius="4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="SUSPEITAS: " Style="{StaticResource MutedText}"/>
                                    <TextBlock Text="{Binding HostsSuspiciousCount}" FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#34D399"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HostsSuspiciousCount}" Value="0">
                                                        <Setter Property="Foreground" Value="#34D399"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Button Content="Verificar Hosts"
                                    Command="{Binding CheckHostsCommand}"
                                    IsEnabled="{Binding IsCheckingHosts, Converter={StaticResource InverseBoolConverter}}"
                                    Style="{StaticResource OutlineButton}"
                                    Padding="12,8"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding HostsEntries}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="None" BorderThickness="0"
                              ColumnHeaderHeight="32" RowHeight="28"
                              Margin="0,0,0,16" MaxHeight="210">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Risk}" Value="Malicious">
                                        <Setter Property="Foreground" Value="#FCA5A5"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Risk}" Value="Suspicious">
                                        <Setter Property="Foreground" Value="#FCD34D"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="IP"       Binding="{Binding IP}"       Width="140"/>
                            <DataGridTextColumn Header="HOSTNAME" Binding="{Binding Hostname}"  Width="*"/>
                            <DataGridTextColumn Header="RISCO"    Binding="{Binding Risk}"      Width="90"/>
                            <DataGridTextColumn Header="MOTIVO"   Binding="{Binding Reason}"    Width="260"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ── SENSITIVE FILES SECTION ── -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Detector de Arquivos Sensíveis" Style="{StaticResource SubHeader}" Margin="0"/>
                            <TextBlock Text="{Binding SensitiveStatus}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource StatCard}" Padding="10,4" Margin="0,0,10,0" CornerRadius="4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ALTO RISCO: " Style="{StaticResource MutedText}"/>
                                    <TextBlock Text="{Binding SensitiveHighCount}" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource Safe}"/>
                                </StackPanel>
                            </Border>
                            <Button Content="Buscar Arquivos"
                                    Command="{Binding ScanSensitiveFilesCommand}"
                                    IsEnabled="{Binding IsScanningForSensitive, Converter={StaticResource InverseBoolConverter}}"
                                    Style="{StaticResource OutlineButton}"
                                    Padding="12,8"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="3" ItemsSource="{Binding SensitiveFiles}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="None" BorderThickness="0"
                              ColumnHeaderHeight="32" RowHeight="28">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Risk}" Value="High">
                                        <Setter Property="Foreground" Value="#FCA5A5"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Risk}" Value="Medium">
                                        <Setter Property="Foreground" Value="#FCD34D"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ARQUIVO"  Binding="{Binding FilePath}"       Width="*"/>
                            <DataGridTextColumn Header="PADRÃO"   Binding="{Binding MatchedPattern}" Width="180"/>
                            <DataGridTextColumn Header="RISCO"    Binding="{Binding Risk}"           Width="80"/>
                            <DataGridTextColumn Header="TAMANHO"  Binding="{Binding SizeKB, StringFormat='{}{0} KB'}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
