<Application x:Class="Antivirus.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Antivirus.UI"
             xmlns:conv="clr-namespace:Antivirus.UI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/AvdonTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:MonitorButtonConverter x:Key="MonitorButtonConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
