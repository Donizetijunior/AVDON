<Window x:Class="Antivirus.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sobre o AVDON"
        Height="540" Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F1F5F9"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <TextBlock Text="AVDON" FontSize="32" FontWeight="Bold"
                       Foreground="#00C8FF" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtVersion" FontSize="13" Foreground="#64748B"
                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
            <TextBlock Text="Antivírus para Windows — .NET 8 / WPF"
                       FontSize="12" Foreground="#475569" HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Component status -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="16">
            <StackPanel>
                <TextBlock Text="STATUS DOS COMPONENTES" FontSize="11" FontWeight="Bold"
                           Foreground="#64748B" Margin="0,0,0,10"/>
                <ItemsControl x:Name="ComponentList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Foreground="#CBD5E1" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="{Binding Status}"
                                           Foreground="{Binding StatusColor}" FontSize="12" FontWeight="SemiBold"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Log viewer -->
        <Border Grid.Row="4" Background="#1E293B" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="LOG DE HOJE" FontSize="11" FontWeight="Bold"
                           Foreground="#64748B" Margin="0,0,0,8"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              x:Name="LogScroller">
                    <TextBlock x:Name="TxtLog"
                               FontFamily="Consolas" FontSize="10"
                               Foreground="#64748B" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Close button -->
        <Button Grid.Row="6" Content="Fechar" HorizontalAlignment="Right"
                Width="90" Height="34"
                Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand"
                Click="BtnClose_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="12,8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
