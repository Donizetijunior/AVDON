<Window x:Class="Antivirus.UI.ThreatToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340" Height="110"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <Color x:Key="DangerColor">#EF4444</Color>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    </Window.Resources>

    <Border CornerRadius="10" Background="#F0141921"
            BorderBrush="#40EF4444" BorderThickness="1"
            Padding="14,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Alert icon -->
            <Border Grid.Column="0" Grid.RowSpan="3"
                    Width="36" Height="36" CornerRadius="8"
                    Background="#26EF4444" Margin="0,0,12,0"
                    VerticalAlignment="Top">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                           FontSize="18" Foreground="#EF4444"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Title -->
            <TextBlock Grid.Column="1" Grid.Row="0"
                       Text="Ameaça detectada!" FontWeight="SemiBold"
                       FontSize="13" Foreground="#FFFFFF"/>

            <!-- File name -->
            <TextBlock Grid.Column="1" Grid.Row="2" x:Name="FileNameText"
                       FontSize="11" Foreground="#A0AEC0"
                       TextTrimming="CharacterEllipsis"/>

            <!-- Action buttons and close -->
            <StackPanel Grid.Column="1" Grid.Row="2"
                        Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom" Margin="0,20,0,0">
                <Button x:Name="QuarantineBtn" Content="Quarentenar"
                        FontSize="11" Padding="10,4" Margin="0,0,6,0"
                        Background="#EF4444" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="Quarantine_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}"
                                    CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#DC2626"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="Ignorar" FontSize="11" Padding="10,4"
                        Background="#1E293B" Foreground="#94A3B8"
                        BorderThickness="0" Cursor="Hand"
                        Click="Dismiss_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}"
                                    CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#334155"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.25"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
